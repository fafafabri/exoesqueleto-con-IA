# Alma Backend Configuration

# Puerto del servidor
PORT=3000

# Base de datos MongoDB (reemplazar con URL real)
MONGODB_URI=mongodb://localhost:27017/alma

# Ambiente
NODE_ENV=development

# JWT Secret para autenticación (si se agrega)
JWT_SECRET=tu_secret_key_aqui_cambia_en_produccion

# CORS - Origen permitido
CORS_ORIGIN=http://localhost:5000,http://localhost:3000

# Email para notificaciones (opcional)
SMTP_EMAIL=tu_email@gmail.com
SMTP_PASSWORD=tu_password_aqui

# Twilio para SMS (opcional)
TWILIO_ACCOUNT_SID=tu_account_sid
TWILIO_AUTH_TOKEN=tu_auth_token
TWILIO_PHONE=+1234567890
